# VERICOM 환경변수 예시
# 실제 값은 커밋하지 않습니다. 로컬은 .env.local, 배포 환경은 호스팅(예: Vercel) 환경변수에 설정하세요.

# ── Supabase 연결 (필수) ─────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
# Project URL. 형식: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon public 키. 브라우저에 노출되어도 안전한 공개 키입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (선택) ─────────────────────────────────
# service_role 비밀 키. 관리용 스크립트(seed/E2E)에서만 사용합니다.
# 브라우저/Client Component에 넣지 않으며, 절대 커밋하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
